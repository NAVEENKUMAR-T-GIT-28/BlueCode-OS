# Copy to .env and fill in. Never commit .env.
# Use URL-safe passwords (letters/digits/-/_) because they are embedded in database URLs.

APP_ENV=production
APP_BASE_URL=https://www.bluecode-os.com
DOMAIN=localhost
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720

# Postgres container (superuser = migration/owner role)
POSTGRES_USER=founder_owner
POSTGRES_PASSWORD=change-me-owner
POSTGRES_DB=founder_os
# Runtime roles created on first database initialisation (RLS applies to these)
APP_DB_PASSWORD=change-me-app
WORKER_DB_PASSWORD=change-me-worker

# Database Connection URLs (for local dev / pytest)
# DATABASE_URL=postgresql://app_user:change-me-app@localhost:5432/founder_os
# WORKER_DATABASE_URL=postgresql://worker_user:change-me-worker@localhost:5432/founder_os
# MIGRATION_DATABASE_URL=postgresql://founder_owner:change-me-owner@localhost:5432/founder_os
# TEST_ADMIN_URL=postgresql://postgres:change-me-owner@localhost:5432/postgres

# Plan and budget
TRIAL_DAYS=15
TRIAL_CAP_MINOR=100000

# Secrets at rest (mailbox passwords). Generate once, keep safe, never change without re-saving mailboxes:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
APP_ENCRYPTION_KEY=

# ---- LLM: choose ONE provider --------------------------------------------------
# LLM_PROVIDER = openai | anthropic | ollama
LLM_PROVIDER=openai
# Model names are NOT defaulted: set the ones you have access to.
#   LLM_MODEL_QUALITY is used for ICP parsing and outreach copy, LLM_MODEL_FAST for scoring/classification.
LLM_MODEL_QUALITY=
LLM_MODEL_FAST=

# openai
OPENAI_API_KEY=
# anthropic
ANTHROPIC_API_KEY=
# ollama (local, free). Start it with:  docker compose --profile ollama up -d
# then pull a model once:  docker compose exec ollama ollama pull <model-name>
OLLAMA_BASE_URL=http://ollama:11434

# Budget gate pricing for cloud providers (USD per million tokens). PLACEHOLDERS: set the real prices
# of the models you chose, or the Rs 1,000 cap will be enforced against wrong numbers.
LLM_PRICE_INPUT_USD_PER_MTOK=3.0
LLM_PRICE_OUTPUT_USD_PER_MTOK=15.0
USD_INR_RATE=85
# Some newer OpenAI models reject a temperature value; set to false if you see HTTP 400 errors.
OPENAI_SEND_TEMPERATURE=true
