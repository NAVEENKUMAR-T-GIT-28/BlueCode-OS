NODE_ENV=development
PORT=4000
# Set true only when running behind a trusted reverse proxy/load balancer.
TRUST_PROXY=false
CORS_ORIGINS=http://localhost:5173,https://blue-code-os-final-frontend.vercel.app
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
JWT_ISSUER=bluecode-os-api
JWT_AUDIENCE=bluecode-os-client
API_RATE_LIMIT=300
AUTH_RATE_LIMIT=20
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
# Optional OpenAPI server entries
# STAGING_API_URL=https://staging-api.example.com
# PRODUCTION_API_URL=https://api.example.com
